---
interface Props {
  text: string;
  as?: "h1" | "p" | "span";
  delay?: number;
  stagger?: number;
  class?: string;
}
const { text, as: Tag = "p", delay = 0, stagger = 0.03, class: cls } = Astro.props;
const words = text.trim().split(/\s+/);
---

<Tag class:list={["te", cls]}>
  {words.map((w, i) => (
    <Fragment><span class="te-w" style={`animation-delay:${(delay + i * stagger).toFixed(3)}s`}>{w}</span>{i < words.length - 1 ? " " : ""}</Fragment>
  ))}
</Tag>

<style>
  .te-w {
    display: inline-block;
    opacity: 0;
    filter: blur(8px);
    transform: translateY(4px);
    animation: te-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  @keyframes te-in {
    to {
      opacity: 1;
      filter: none;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .te-w {
      animation: none;
      opacity: 1;
      filter: none;
      transform: none;
    }
  }
</style>